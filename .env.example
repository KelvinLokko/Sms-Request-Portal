APP_NAME="SMS Client Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# PHP-FPM is exposed only to nginx on the host loopback interface.
PHP_FPM_PORT=9000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sms_client_portal
DB_USERNAME=sms
DB_PASSWORD=secret
DB_SSLMODE=prefer

# Containers reach PostgreSQL running on the Docker host through this name.
DOCKER_DB_HOST=host.docker.internal

# -----------------------------------------------------------------------------
# Session / cache
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
# CACHE_PREFIX=

# -----------------------------------------------------------------------------
# Queues (Redis + Horizon)
# QUEUE_CONNECTION must be redis for Horizon.
# Named queues used by the app (configure workers in config/horizon.php):
#   - default        general jobs
#   - validation     contact list / file validation
#   - pdf            invoice / PDF generation
#   - notifications  mail / alerts
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
# REDIS_QUEUE=default

# Horizon dashboard path (do not expose publicly without auth)
HORIZON_PATH=horizon

BROADCAST_CONNECTION=log

# local = filesystem under storage/app/private (dev)
# r2    = Cloudflare R2 (production — S3-compatible)
FILESYSTEM_DISK=local

MEMCACHED_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (log driver for local; configure SMTP/SES in non-local envs)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Optional Telegram lifecycle alerts (disabled by default)
# -----------------------------------------------------------------------------
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Object storage — Cloudflare R2 (production) or AWS S3
# -----------------------------------------------------------------------------
# Set FILESYSTEM_DISK=r2 and fill the R2_* values from the Cloudflare dashboard:
#   R2 → Manage R2 API Tokens → create token with Object Read & Write
#   Endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=true

# Generic S3 fallback (optional). R2_* values take precedence when using the r2 disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Marketing landing page (public)
# -----------------------------------------------------------------------------
MARKETING_BRAND="${APP_NAME}"
MARKETING_TAGLINE="Submit SMS campaigns. We handle the rest."
MARKETING_DESCRIPTION="A secure client portal for businesses to submit SMS campaign requests, upload recipient lists, receive invoices, and track fulfilment — while our team sends every message for you."
MARKETING_CONTACT_EMAIL="hello@example.com"
MARKETING_CONTACT_PHONE=

VITE_APP_NAME="${APP_NAME}"
